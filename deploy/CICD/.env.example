# Deployment settings for startup_hr Flutter Web.
# Copy this file to deploy/CICD/.env for local testing.
# No secrets belong here; this file must stay committed.
# The real .env (deploy/CICD/.env) is git-ignored for local port overrides.

# Host port that the web container publishes to (container listens on 8080).
APP_PORT=8080

# Production deployments must reference a published image with an immutable tag
# or digest. Required by docker-compose.production.yml.
IMAGE_REF=ghcr.io/suebtas/lab3@sha256:<paste-published-digest>